{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Doc Scan PDF Editor (flet run)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/Scripts/flet",
      "args": ["run", "src/docscanner/app/main.py"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
